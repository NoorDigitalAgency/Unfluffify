{
  "manifest_version": 3,
  "name": "Unfluffify",
  "version": "1.1.1",
  "description": "Chrome extension to label what's non-meaningful text content to help AI find the meaningful text content.",
  "action": {
    "default_title": "Unfluffify"
  },
  "permissions": [
    "storage",
    "offscreen",
    "sidePanel",
    "desktopCapture",
    "tabs",
    "scripting",
    "debugger",
    "browsingData",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "content/*.js",
        "common/*.js",
        "assets/materialdesignicons-webfont.woff2",
        "remote-support-viewer.html",
        "remote-support-viewer.js",
        "cursors/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/default/icon16.png",
    "32": "icons/default/icon32.png",
    "48": "icons/default/icon48.png",
    "128": "icons/default/icon128.png"
  }
}
