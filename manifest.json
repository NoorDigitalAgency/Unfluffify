{
  "manifest_version": 3,
  "name": "Unfluffify",
  "version": "1.2.0",
  "description": "Chrome extension to label what's non-meaningful text content to help AI find the meaningful text content.",
  "action": {
    "default_title": "Unfluffify"
  },
  "permissions": [
    "storage",
    "offscreen",
    "sidePanel",
    "desktopCapture",
    "tabs",
    "scripting",
    "debugger",
    "browsingData",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common/page-motion-freeze-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "content/constants.js",
        "content/core.js",
        "content/marking-rules.js",
        "content/shared-inclusion.js",
        "content/shared-selector-cache.js",
        "content/silent-highlight-rules.js",
        "content/submission-rules.js",
        "content/content-command-router.js",
        "content/ai-preview-close-handler.js",
        "content/ai-preview-compute-lock-handler.js",
        "content/ai-preview-expanded-mode-handler.js",
        "content/ai-preview-get-state-handler.js",
        "content/ai-preview-state-response.js",
        "content/default-exclusions-handler.js",
        "content/inspection-status.js",
        "content/page-world-relay.js",
        "content/page-telemetry-bridge.js",
        "content/page-toast.js",
          "content/render-mode-inspection-handlers.js",
        "content/render-mode-inspection-client.js",
        "content/property-lock-banner.js",
        "content/property-lock-banner-mode.js",
        "content/property-lock-port-client.js",
        "content/property-lock-state-machine.js",
        "content/remote-support-client.js",
        "content/remote-support-state-handler.js",
        "content/remote-support-viewer-client.js",
        "content/remote-support-support-page.js",
        "content/visible-xpaths-handler.js",
        "common/config.js",
        "common/constants.js",
        "common/extension-telemetry.js",
        "common/feature-flags.js",
        "common/page-telemetry.js",
        "common/lynx-checklist.js",
        "common/lynx-live-pages.js",
        "common/property-lock.js",
        "common/remote-support.js",
        "common/selector-set.js",
        "common/text.js",
        "common/utilities.js",
        "common/world-messaging-contract.js",
        "assets/materialdesignicons-webfont.woff2",
        "remote-support-viewer.html",
        "remote-support-viewer.js",
        "cursors/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/default/icon16.png",
    "32": "icons/default/icon32.png",
    "48": "icons/default/icon48.png",
    "128": "icons/default/icon128.png"
  }
}
