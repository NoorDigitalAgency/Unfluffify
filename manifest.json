{
  "manifest_version": 3,
  "name": "Unfluffify",
  "version": "0.1.0",
  "description": "Chrome extension to label what's non-meaningful text content to help AI find the meaningful text content.",
  "action": {
    "default_title": "Unfluffify"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "downloads",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "debugger",
    "browsingData",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "content/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
