# Dependencies
node_modules/

# Build and local staging output
.output/
.temp/
.tmp/
.wxt/
.scratch-blink-test/
dist/
coverage/
*.log
pnpm-debug.log*

# Local browser / MCP state
.wxt/browser-profile/
.wxt/browser-profile-reuse/
.playwright-mcp/
# P14 retains completed acceptance reports, but not local intermediates or
# convenience reports from smoke/diagnostic runs.
output/playwright/p14-marking-performance/build/
output/playwright/p14-marking-performance/latest.json
output/playwright/p14-marking-performance/diagnostic-*.json
output/playwright/p14-marking-performance/failure-*.json
output/playwright/p14-marking-performance/smoke-*.json
# P25 live-comparison runs can contain many screenshots and frame samples. Keep
# the durable root and its checked-in contract README, but never mix generated
# run evidence into source status or a build identity.
output/playwright/p25-live-comparison/*
!output/playwright/p25-live-comparison/README.md

# Non-Copilot local agent state
.agents/
.claude/
.codex/

# Editor-local workspace state
.vs/
.vscode/*.code-workspace
*.swp
*.swo
.DS_Store

# Local orchestration secrets and artifacts
orchestration/.secrets.json
orchestration/.secrets.jsonc
orchestration/config.json
orchestration/config.jsonc
orchestration/ssh-rpc.local.json
orchestration/ssh-rpc.local.jsonc
orchestration/ssh-rpc.secrets.json
orchestration/ssh-rpc.secrets.jsonc
orchestration/.ssh/
orchestration/runs/
orchestration/profiles/
orchestration/.profiles/
