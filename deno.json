{
  "nodeModulesDir": "auto",
  "tasks": {
    "orchestrate:bus": "deno run --allow-read --allow-write --allow-env --allow-net ./orchestration/bus-server.mjs",
    "orchestrate:mock-client": "deno run --allow-read --allow-write --allow-env --allow-net ./orchestration/mock-client.mjs",
    "orchestrate:runner": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys ./orchestration/runner.mjs",
    "orchestrate:setup-auth": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys ./orchestration/setup-auth.mjs",
    "orchestrate:property-lock": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys ./orchestration/scenarios/property-lock-one-machine.mjs",
    "orchestrate:rpc-server": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys ./orchestration/rpc-server.mjs",
    "orchestrate:rpc-client": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys ./orchestration/rpc-client.mjs"
  },
  "lint": {
    "exclude": [
      "dist",
      "node_modules",
      ".tmp",
      "popup/vendor"
    ],
    "rules": {
      "exclude": [
        "ban-ts-comment",
        "no-inner-declarations",
        "no-sloppy-imports",
        "no-window",
        "no-window-prefix"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.19/bdd",
    "@types/chrome": "npm:@types/chrome@^0.1.43",
    "esbuild": "npm:esbuild@^0.28.1"
  }
}
