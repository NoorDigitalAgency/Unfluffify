{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno run --allow-read --allow-env --allow-sys npm:typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-net=127.0.0.1 --no-check --unstable-sloppy-imports tests",
    "lint": "deno lint scripts/build-extension.ts scripts/count-ts-suppressions.ts scripts/emit-package-metadata.ts scripts/package-extension.mjs",
    "lint:fix": "deno lint --fix scripts/build-extension.ts scripts/count-ts-suppressions.ts scripts/emit-package-metadata.ts scripts/package-extension.mjs",
    "build": "deno task build:release",
    "package": "deno run --allow-read --allow-write ./scripts/package-extension.mjs --source-root dist/extension",
    "build:dev": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys ./scripts/build-extension.ts --dev",
    "build:release": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys ./scripts/build-extension.ts --release",
    "watch": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys ./scripts/build-extension.ts --dev --watch",
    "dev": "deno task watch",
    "verify": "deno task check && deno task test && deno task build:release"
  },
  "lint": {
    "exclude": [
      "dist",
      "node_modules",
      ".tmp",
      "popup/vendor"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.19/bdd",
    "@types/chrome": "npm:@types/chrome@^0.1.43",
    "esbuild": "npm:esbuild@^0.28.1"
  }
}
