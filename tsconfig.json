{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": []
  },
  "include": [
    "background/**/*.ts",
    "common/**/*.ts",
    "content/**/*.ts",
    "popup/**/*.ts",
    "background.ts",
    "content-loader.ts",
    "content-main.ts",
    "popup.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".tmp"
  ]
}
