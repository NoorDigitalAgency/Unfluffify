{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src/background/**/*.ts",
    "src/common/**/*.ts",
    "src/content/**/*.ts",
    "src/popup/**/*.ts",
    "src/popup/**/*.tsx",
    "src/background.ts",
    "src/content-main.ts",
    "src/popup.ts",
    "src/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".tmp"
  ]
}
