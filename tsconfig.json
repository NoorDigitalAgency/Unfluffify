{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src/background/index.ts",
    "src/background/brain/decide.ts",
    "src/background/brain/fold.ts",
    "src/background/brain/project.ts",
    "src/background/brain/signals.ts",
    "src/background/keepalive.ts",
    "src/background/persistence.ts",
    "src/background/rewrite-brain-runtime.ts",
    "src/domain/**/*.ts",
    "src/messaging/**/*.ts",
    "src/storage/**/*.ts",
    "src/lynx/**/*.ts",
    "src/lock/**/*.ts",
    "src/content/activation.ts",
    "src/content/runtime.ts",
    "src/content/marking/**/*.ts",
    "src/content/stabilization/**/*.ts",
    "src/popup/App.tsx",
    "src/popup/store.ts",
    "src/popup/organ/**/*.ts",
    "src/entrypoints/**/*.ts",
    "src/entrypoints/**/*.tsx",
    "src/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".tmp"
  ]
}
