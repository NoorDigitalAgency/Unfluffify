{
  "browser": {
    "browserName": "chromium",
    "chromiumSandbox": false,
    "launchOptions": {
      "headless": false,
      "executablePath": "__CHROMIUM_EXECUTABLE_PATH__",
      "ignoreDefaultArgs": [
        "--disable-extensions"
      ],
      "args": [
        "--no-sandbox",
        "--load-extension=__UNFLUFFIFY_REPO_ROOT__/dist/extension-dev",
        "--disable-extensions-except=__UNFLUFFIFY_REPO_ROOT__/dist/extension-dev"
      ]
    }
  }
}
