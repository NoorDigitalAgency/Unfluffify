{
  // Shared staging values that the auth seeding script writes into the
  // extension configuration view before logging in.
  "config": {
    // Full URL for the Configuration Endpoint field in the extension popup.
    "configurationEndpoint": "https://example.test/configuration",

    // Full URL for the AI Endpoint field in the extension popup.
    "aiEndpoint": "https://example.test/ai",

    // Hostname for the Stage Base field. A URL is also accepted, but only the
    // host is stored, so "https://noorlynx.com/path" becomes "noorlynx.com".
    "stageBase": "noorlynx.com"
  },

  // Login credentials keyed by account name. The runner's `account` field in
  // `config.jsonc` selects one of these entries.
  "accounts": {
    // Director-side account. Use a real staging user email and password.
    "A": {
      // Email address submitted in the extension login form.
      "email": "account-a@example.test",

      // Password submitted in the extension login form. Do not commit the
      // filled `.secrets.jsonc` file.
      "password": "replace-me"
    },

    // Follower-side account. Use a different real staging user when testing
    // cross-user locking or remote-support flows.
    "B": {
      // Email address submitted in the extension login form.
      "email": "account-b@example.test",

      // Password submitted in the extension login form. Do not commit the
      // filled `.secrets.jsonc` file.
      "password": "replace-me"
    }
  }
}
