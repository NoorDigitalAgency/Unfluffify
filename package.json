{
  "name": "unfluffify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "page-world:generate": "node ./scripts/generate-page-world.mjs",
    "page-world:check": "node ./scripts/generate-page-world.mjs --check",
    "prepare": "pnpm page-world:generate && wxt prepare",
    "dev": "wxt",
    "dev:no-browser": "UNFLUFFIFY_NO_BROWSER=1 wxt",
    "build": "pnpm page-world:check && wxt build",
    "build:debug": "pnpm page-world:check && UNFLUFFIFY_DEBUG=1 wxt build",
    "zip": "pnpm build && node ./scripts/create-output-zip.mjs ./.output/chrome-mv3 ./.output/unfluffify-bootstrap.zip",
    "deploy:zip": "pnpm build && node ./scripts/deploy-versioned-zip.mjs",
    "check": "pnpm page-world:check && wxt prepare && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.wxt.json && tsc --noEmit -p tsconfig.wxt-node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "browser:live": "node ./scripts/launch-test-browser.mjs",
    "browser:observe": "node ./scripts/observe-live-console.mjs",
    "performance:p14": "node ./scripts/performance/p14-marking-browser-gate.mjs",
    "performance:p14:smoke": "node ./scripts/performance/p14-marking-browser-gate.mjs --smoke",
    "performance:p15": "node ./scripts/performance/p15-frozen-shield-browser-gate.mjs",
    "performance:p15:smoke": "node ./scripts/performance/p15-frozen-shield-browser-gate.mjs --smoke",
    "performance:p16": "node ./scripts/performance/p16-render-inspection-browser-gate.mjs",
    "performance:p16:smoke": "node ./scripts/performance/p16-render-inspection-browser-gate.mjs --smoke",
    "performance:p17": "node ./scripts/performance/p17-preview-browser-gate.mjs",
    "performance:p17:smoke": "node ./scripts/performance/p17-preview-browser-gate.mjs --smoke",
    "performance:p18": "node ./scripts/performance/p18-transient-toast-browser-gate.mjs",
    "performance:p18:smoke": "node ./scripts/performance/p18-transient-toast-browser-gate.mjs --smoke",
    "performance:p20": "node ./scripts/performance/p20-integrated-browser-gate.mjs",
    "performance:p20:smoke": "node ./scripts/performance/p20-integrated-browser-gate.mjs --smoke",
    "orchestrate:bus": "node ./orchestration/bus-server.mjs",
    "orchestrate:mock-client": "node ./orchestration/mock-client.mjs",
    "orchestrate:runner": "node ./orchestration/runner.mjs",
    "orchestrate:setup-auth": "node ./orchestration/setup-auth.mjs",
    "orchestrate:property-lock": "node ./orchestration/scenarios/property-lock-one-machine.mjs",
    "orchestrate:rpc-server": "node ./orchestration/rpc-server.mjs",
    "orchestrate:rpc-client": "node ./orchestration/rpc-client.mjs",
    "verify": "pnpm lint && pnpm check && pnpm test && node ./scripts/remove-path.mjs ./.output && pnpm build && UF_MANIFEST_SOURCE=generated vitest run tests/manifest-permissions.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "ws": "^8.21.0",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@webext-core/messaging": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  }
}
