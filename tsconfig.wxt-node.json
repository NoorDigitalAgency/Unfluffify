{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "wxt.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".tmp",
    ".output",
    ".wxt"
  ]
}
